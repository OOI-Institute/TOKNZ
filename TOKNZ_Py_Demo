Below is a Lightweight TOKNZ demo:

"""

import os
from dataclasses import dataclass, field
from typing import List, Optional, Protocol
import re

# ============================
# Data Models
# ============================
@dataclass
class TaskState:
    goal: str
    domains: List[str] = field(default_factory=list)
    constraints: List[str] = field(default_factory=list)
    active_facts: List[str] = field(default_factory=list)
    last_delta: Optional[str] = None


@dataclass
class ToknzPayload:
    state_summary: str
    delta: str
    relevant_context: List[str]
    constraints: List[str]
    handoff_prompt: str


# ============================
# LLM Interface (any LLM)
# ============================
class LLMClient(Protocol):
    """Simple protocol for any LLM. Easy to implement for Groq, Anthropic, Ollama, etc."""
    def generate(self, prompt: str, model: str = "gpt-4o-mini") -> str: ...


class OpenAIClient:
    """Default implementation using OpenAI."""
    def __init__(self):
        import openai
        self.client = openai.OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
        if not self.client.api_key:
            raise ValueError("OPENAI_API_KEY environment variable not set.")

    def generate(self, prompt: str, model: str = "gpt-4o-mini") -> str:
        response = self.client.chat.completions.create(
            model=model,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.7,
            max_tokens=800,
        )
        return response.choices[0].message.content.strip()


# ============================
# TOKNZ Engine
# ============================
class ToknzDemoEngine:
    def __init__(self):
        self.state: Optional[TaskState] = None

    def process_turn(self, user_input: str) -> ToknzPayload:
        domains = self.detect_domains(user_input)
        constraints = self.detect_constraints(user_input)
        facts = self.extract_facts(user_input)

        if self.state is None:
            self.state = TaskState(
                goal=self.detect_goal(user_input),
                domains=domains,
                constraints=constraints,
                active_facts=facts,
                last_delta="Initial state established."
            )
            delta = "Initial state established."
        else:
            delta = self.detect_delta(user_input, self.state.active_facts)
            self.state.domains = sorted(set(self.state.domains + domains))
            self.state.constraints = sorted(set(self.state.constraints + constraints))
            self.state.active_facts = self.merge_relevant_facts(self.state.active_facts, facts)
            self.state.last_delta = delta

        relevant_context = self.compress_context(self.state.active_facts)
        handoff_prompt = self.build_handoff_prompt(self.state, delta, relevant_context)

        return ToknzPayload(
            state_summary=self.summarize_state(self.state),
            delta=delta,
            relevant_context=relevant_context,
            constraints=self.state.constraints,
            handoff_prompt=handoff_prompt,
        )

    # ------------------------------------------------------------------
    # Detection & State Logic
    # ------------------------------------------------------------------
    def detect_goal(self, text: str) -> str:
        lowered = text.lower()
        if "plan" in lowered:
            return "Create an operational stabilization plan."
        if "risk" in lowered:
            return "Identify risks and safe stabilization actions."
        return "Maintain coherent task state and support downstream reasoning."

    def detect_domains(self, text: str) -> List[str]:
        domain_keywords = {
            "infrastructure": ["grid", "substation", "power", "water", "diesel"],
            "operations": ["plan", "monitor", "response", "schedule"],
            "safety": ["risk", "safe", "stabilize"],
        }
        found = []
        lowered = text.lower()
        for domain, keywords in domain_keywords.items():
            if any(kw in lowered for kw in keywords):
                found.append(domain)
        return found or ["general"]

    def detect_constraints(self, text: str) -> List[str]:
        lowered = text.lower()
        constraints = []
        if "safe" in lowered or "risk" in lowered:
            constraints.append("safety-sensitive")
        if "no overcorrection" in lowered:
            constraints.append("avoid-overcorrection")
        if "immediate" in lowered or "now" in lowered:
            constraints.append("time-sensitive")
        if "final" in lowered:
            constraints.append("completion-oriented")
        return constraints

    def extract_facts(self, text: str) -> List[str]:
        sentences = re.split(r"[.!?]\s+", text.strip())
        return [s.strip() for s in sentences if len(s.strip()) > 8]

    def detect_delta(self, text: str, prior_facts: List[str]) -> str:
        lowered = text.lower()
        if any(term in lowered for term in ["now", "just", "another", "changed", "updated"]):
            return f"Delta: {text[:150]}..."
        return "Continuation: No major delta detected."

    def merge_relevant_facts(self, existing: List[str], new_facts: List[str], max_facts: int = 8) -> List[str]:
        merged = existing + new_facts
        seen = set()
        retained = []
        for fact in merged:
            key = fact.lower()
            if key not in seen:
                seen.add(key)
                retained.append(fact)
        return retained[-max_facts:]

    def compress_context(self, facts: List[str], max_items: int = 5) -> List[str]:
        return facts[-max_items:]

    def summarize_state(self, state: TaskState) -> str:
        return (
            f"Goal: {state.goal}\n"
            f"Domains: {', '.join(state.domains)}\n"
            f"Constraints: {', '.join(state.constraints) or 'none'}\n"
            f"Last Delta: {state.last_delta}"
        )

    def build_handoff_prompt(
        self, state: TaskState, delta: str, relevant_context: List[str]
    ) -> str:
        context_str = "\n".join(f"- {item}" for item in relevant_context)
        return f"""You are receiving a TOKNZ-governed task handoff.

Do not rebuild the entire problem from scratch.
Use the active state below and apply only the current delta.

ACTIVE GOAL:
{state.goal}

DOMAINS:
{', '.join(state.domains)}

CONSTRAINTS:
{', '.join(state.constraints) or 'none'}

CURRENT DELTA:
{delta}

RELEVANT CONTEXT:
{context_str}

INSTRUCTION:
Produce a focused response that continues the existing task state,
preserves all constraints, avoids unnecessary repetition, and moves the task forward.
""".strip()


# ============================
# Demo Runner with Real LLM
# ============================
if __name__ == "__main__":
    # Initialize TOKNZ engine
    engine = ToknzDemoEngine()

    # Initialize LLM client (easy to swap)
    try:
        llm: LLMClient = OpenAIClient()          # Change this line for other LLMs
        print("✅ OpenAI client initialized.\n")
    except Exception as e:
        print(f"⚠️ LLM initialization failed: {e}")
        print("Please set OPENAI_API_KEY or implement your own LLMClient.")
        exit(1)

    turns = [
        "We have a cold snap stressing the electrical grid. Two substations are offline, warming centers are increasing demand, water pipes may burst, and diesel delivery is delayed. Identify risks and safe immediate actions with no overcorrection.",
        "One substation just came back online, but load is still rising. What changes?",
        "We are now seeing water pressure drops in two zones. What is likely happening?",
        "Diesel delivery is delayed another six hours. What is our risk window now?",
        "Give me a final six-hour stabilization plan.",
    ]

    print("🚀 TOKNZ + Real LLM Demo — Continuous State Evolution\n")

    for i, turn in enumerate(turns, start=1):
        # 1. TOKNZ processes the turn
        payload = engine.process_turn(turn)

        print("=" * 90)
        print(f"TOKNZ TURN {i}")
        print("=" * 90)
        print(f"USER: {turn}\n")
        print("STATE SUMMARY:")
        print(payload.state_summary)
        print(f"\nDELTA: {payload.delta}\n")

        # 2. Call the real LLM with TOKNZ handoff prompt
        print("🤖 LLM RESPONSE:")
        response = llm.generate(payload.handoff_prompt, model="gpt-4o-mini")
        print(response)
        print("\n")

